      {
        "concept": "Affine relation",
        "explanation": "The output is defined by y = gain*x + offset.",
        "source_pages": []
      },
      {
        "concept": "Gain",
        "explanation": "Gain is the coefficient of x and controls how strongly y changes as x changes; it can range from -3 to 3.",
        "source_pages": []
      },
      {
        "concept": "Offset",
        "explanation": "Offset is the constant term and equals the value of y when x = 0; it can range from -4 to 4.",
        "source_pages": []
      },
      {
        "concept": "Anchor at x = 0",
        "explanation": "Substituting x = 0 gives y = offset.",
        "source_pages": []
      },
